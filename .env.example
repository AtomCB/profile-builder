# Google Gemini API key (free tier). Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: model ID override. Must be a model your key can use on the free tier
# (check https://aistudio.google.com/rate-limit). Defaults to gemini-3.6-flash. If it is overloaded or unavailable,
# the app falls back to gemini-3.5-flash-lite, then gemini-3.1-flash-lite.
GEMINI_MODEL=gemini-3.6-flash
